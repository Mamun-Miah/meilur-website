{
  "name": "meilleur-events",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "15.5.28",
    "nodemailer": "7.0.13",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sharp": "0.34.5",
    "zod": "3.25.76",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.mjs"
  }
}

# ---- Required -------------------------------------------------------------
# SQLite for local development. Production: a PostgreSQL URL, e.g.
# postgresql://USER:PASSWORD@HOST:5432/meilleur?schema=public  (see docs/DEPLOYMENT.md)
DATABASE_URL="file:./dev.db"

# Public origin of the site, used for canonical URLs, sitemap and email links.
SITE_URL="http://localhost:3000"

# ---- First admin (used by `npm run db:seed` and `npm run admin:create`) -----
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# ---- Email notifications (choose one; leave both empty to log to the console)
# Resend (https://resend.com): API key and a verified sender address.
RESEND_API_KEY=""
# Any SMTP server, e.g. Gmail with an app password, or your host's SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# From address for outgoing mail, e.g. "MEILLEUR Website <website@yourdomain.com>"
MAIL_FROM=""

# ---- Image storage --------------------------------------------------------
# Cloudinary credentials. When empty, uploads are written to ./public/uploads,
# which is fine for local development but NOT for serverless hosting.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="meilleur"
